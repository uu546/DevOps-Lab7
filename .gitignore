# Binaries for programs and plugins*.exe*.exe~*.dll*.so*.dylib# Test binary, built with `go test -c`*.test# Output of the go coverage tool, specifically when used with -coverprofile*.outcoverage.**.coverprofileprofile.cov# Dependency directories (remove the comment below to include it)# vendor/# Go workspace filego.workgo.work.sum# Environment files.env# IDE and Editor files.idea/.vscode/*.suo*.ntvs**.njsproj*.sln*.sw?